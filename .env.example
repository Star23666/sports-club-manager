# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-unique-long-random-password
MYSQL_DATABASE=badminton1
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-unique-long-random-password

# Backend
BACKEND_PORT=8081
# Optional: exact client/admin Nginx container IPs after verifying their actual addresses.
# Empty means only the directly connected peer is used for rate limiting.
TRUSTED_PROXY_IPS=

# SMTP (optional — required for password reset email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
