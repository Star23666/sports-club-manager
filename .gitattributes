# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text eol=lf
*.pyi text eol=lf

# Web
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Config / scripts
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sql text eol=lf
*.tex text eol=lf
*.puml text eol=lf

# Documentation
*.md text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
