DB_PASSWORD=123456

# ── Email (optional, for password reset) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Server ────────────────────────────────────────────
PORT=8081
