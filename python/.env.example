# ── Branding (customize for your club) ─────────────────
APP_NAME="体育俱乐部管理系统"
ORG_NAME="体育俱乐部"
MEMBER_ID_LABEL="学号"
EMAIL_DOMAIN=""                    # e.g. "student.university.edu" for auto-generated emails

# ── Database ──────────────────────────────────────────
DB_TYPE=sqlite                     # "sqlite" (zero-config) or "mysql"
# Optional: absolute path to a separate SQLite file for local test data.
# SQLITE_PATH=C:/path/to/club-preview.sqlite3
# MySQL only:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=badminton1
DB_USER=root
DB_PASSWORD=replace-with-a-unique-long-random-password

# ── Email (optional, for password reset) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Server ────────────────────────────────────────────
PORT=8081
CORS_ORIGINS=http://localhost:8080,http://localhost:8082
LOGIN_ACCOUNT_LIMIT=8
LOGIN_IP_LIMIT=120
LOGIN_WINDOW_SECONDS=900
REGISTER_IP_LIMIT=10
REGISTER_WINDOW_SECONDS=3600
# Exact IPs of reverse proxies that overwrite X-Real-IP; empty is the safe default.
TRUSTED_PROXY_IPS=
